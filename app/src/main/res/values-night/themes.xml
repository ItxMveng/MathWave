        <item name="colorOnSecondary">@color/enib_orange_dark</item>
        <item name="android:colorBackground">#1A1A1A</item>
        <item name="colorSurface">#2C2C2C</item>
        <item name="colorOnSurface">@color/enib_white</item>
        <item name="colorError">@color/enib_error</item>
        <item name="windowActionBar">false</item>
